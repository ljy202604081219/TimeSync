# ---- 数据库 -------------------------------------------------------------
# 本地默认 SQLite；云端改成 Neon/Render 的 PostgreSQL 连接串。
# 支持 postgres:// 与 postgresql:// 写法，后端会自动换成 psycopg 驱动。
# 示例：DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/timesync?sslmode=require
DATABASE_URL=sqlite:///./timesync.db
# 连接串里没有 sslmode 时追加（Neon 必填 require）
DB_SSLMODE=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
# 业务写锁（PostgreSQL advisory lock / SQLite BEGIN IMMEDIATE）的最长等待毫秒数，
# 超时返回 503 {"code":"busy"}，客户端可安全重试
DB_LOCK_TIMEOUT_MS=15000
# 启动时自动执行版本化迁移（只增不删）；设为 false 时由发布流程单独执行 python -m app.migrate
AUTO_MIGRATE=true
# 云端首次启动初始化：仅当用户表为空时创建 A/B/C/D 合成身份与当周演示数据，
# 非空库（重启、重新部署、第二个 worker）不会写入任何东西。本地用 DEMO_MODE 即可，保持 false。
BOOTSTRAP_FIXTURES=false
# 初始化数据的演示周起始周一（YYYY-MM-DD）；留空表示本周
BOOTSTRAP_ANCHOR=

# ---- 身份与登录 ---------------------------------------------------------
# true 时开放 /api/demo/accounts 并以四个永久演示令牌鉴权，仅限本机使用
DEMO_MODE=true
# 是否继续接受四个永久用户令牌。留空＝跟随 DEMO_MODE；云端必须为 false
LEGACY_TOKEN_AUTH=
# 短时沙箱会话（公网 Web 入口）。云端 true，本地可保持 false 继续用演示令牌
SANDBOX_MODE=false
SANDBOX_SESSION_TTL_MINUTES=180
SANDBOX_MAX_ACTIVE_SESSIONS=40
# 设备只读凭据默认有效期（天），范围 1–90
DEVICE_TOKEN_TTL_DAYS=7
# 管理员凭据：用于签发/撤销设备凭据。至少 16 字符；留空则管理接口返回 503。
# 只放在平台 Secret 或本机 .env，不要提交、不要发到群里。
ADMIN_TOKEN=

# ---- 模型（MiMo）-------------------------------------------------------
AI_PROVIDER=mimo
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.6-pro
AI_API_KEY=

# ---- AI 调用保护 --------------------------------------------------------
AI_BUDGET_ENABLED=false
# 以下仅保留给旧配置兼容；AI_BUDGET_ENABLED=false时不生效，不设每日次数限制。
AI_DAILY_BUDGET=
AI_ACTOR_DAILY_BUDGET=
AI_MAX_CONCURRENCY=1
# 通用在途请求保留时间（秒）；QQ/助手有45/60秒硬超时，超过90秒自动回收
AI_RESERVATION_TTL_SECONDS=600

# ---- 请求体积 -----------------------------------------------------------
# 整个请求体上限，在 multipart 解析前生效；单张截图另有 6 MB 限制
MAX_REQUEST_BYTES=8388608

# ---- 运行 ---------------------------------------------------------------
# 容器内由 start.sh 展开；Render 会注入自己的 PORT
PORT=8000
WEB_CONCURRENCY=1
TZ=Asia/Shanghai

# Assistant: auto uses configured AI provider; mock never calls a model.
ASSISTANT_MODE=auto
# Direct user requests to add personal events/tasks are saved after validation.
# Other changes keep their existing preview/confirmation flow.
ASSISTANT_AUTO_CREATE=true
# Optional assistant-only model. Empty follows AI_MODEL; extraction keeps AI_MODEL.
# Set mimo-v2.6-flash only after verifying access and multi-turn behavior.
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT_SECONDS=60

# Project-wide AI is server-managed. Keep user-facing setup hidden.
AI_ADMIN_UI=false

# ---- QQ 群通知（默认只接受合成事件） -----------------------------------
# 公共沙箱 SANDBOX_MODE=true 时，真实入口始终关闭。
QQ_PUBLIC_DEMO=true
QQ_LIVE_ENABLED=false
# 原文队列、超时租约恢复、保留期限清理；不登录QQ、不发送消息。
QQ_PROCESSOR_ENABLED=true
# auto复用AI_API_KEY/AI_MODEL；mock绝不调用真实模型，图片不做OCR。
QQ_AI_MODE=auto
# 外部OneBot事件独立认证，至少24字符；支持Bearer或OneBot X-Signature。
QQ_EVENT_SECRET=
# 可选只读历史补采，默认关闭；每分钟、每轮最多300条、24小时窗口。
QQ_HISTORY_ENABLED=false
QQ_ONEBOT_API_URL=
QQ_ONEBOT_API_TOKEN=

# Optional: explicitly pin a locally logged-in small QQ account. Empty = disabled.
# Actual QQ login/runtime stays outside this source package. Never commit credentials.
QQ_MANAGED_BOT_ID=
QQ_MANAGED_NICKNAME=
QQ_CAPTURE_OWNER_ID=A
QQ_CAPTURE_ALL_GROUPS=false
QQ_CAPTURE_PRIVATE=false
QQ_CAPTURE_SELF=false

# Explicit opt-in: reply only to one verified private peer, never to groups.
QQ_REPLY_ENABLED=false
QQ_REPLY_PEER_ID=
